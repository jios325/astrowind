---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

interface ContactInput {
  type: string;
  name: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  options?: { value: string; label: string }[];
}

interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  description?: string;
  inputs?: ContactInput[];
  textarea?: {
    label?: string;
    placeholder?: string;
    rows?: number;
    required?: boolean;
  };
  disclaimer?: {
    label?: string;
  };
  button?: {
    title?: string;
    type?: string;
  };
  
  id?: string;
  isDark?: boolean;
  classes?: Record<string, string>;
  bg?: string;
}

const {
  title = '',
  subtitle = '',
  tagline = '',
  description = '',
  inputs = [],
  textarea = {},
  disclaimer = {},
  button = {},
  
  id,
  isDark = false,
  classes = {},
  bg,
} = Astro.props as Props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div class="grid gap-10 md:grid-cols-2">
    <div class="order-2 md:order-1">
      <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container: 'max-w-xl',
          title: 'text-3xl lg:text-4xl',
          ...((classes?.headline as {}) ?? {}),
        }}
      />
      <div class="max-w-xl">
        {description && <p class="text-muted mt-3 mb-8 text-base dark:text-slate-400">{description}</p>}
        <form id="contactForm" class="mb-12 space-y-6" method="POST" action="">
          {
            inputs &&
              inputs.map(({ type, name, label, placeholder, required, options }) => (
                <div>
                  <label for={name} class="mb-2 block text-sm font-medium">
                    {label} {required && <span class="text-red-600">*</span>}
                  </label>
                  {type === 'select' ? (
                    <select
                      id={name}
                      name={name}
                      required={required}
                      class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-slate-900"
                    >
                      {options && options.map(({ value, label }) => <option value={value}>{label}</option>)}
                    </select>
                  ) : (
                    <input
                      type={type}
                      id={name}
                      name={name}
                      placeholder={placeholder}
                      required={required}
                      class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-slate-900"
                    />
                  )}
                </div>
              ))
          }
          {
            textarea && (
              <div>
                <label for="message" class="mb-2 block text-sm font-medium">
                  {textarea.label} {textarea.required && <span class="text-red-600">*</span>}
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows={textarea.rows || 5}
                  placeholder={textarea.placeholder}
                  required={textarea.required}
                  class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-slate-900"
                />
              </div>
            )
          }
          {
            disclaimer && disclaimer.label && (
              <div class="text-sm text-gray-600 dark:text-slate-400" set:html={disclaimer.label} />
            )
          }
          <div>
            <Button type={button?.type || 'submit'} variant="primary" class="w-full md:w-auto">
              {button?.title || 'Send Message'}
            </Button>
          </div>
        </form>
      </div>
    </div>
    <div class="order-1 md:order-2">
      <div class="bg-primary-100 relative h-full max-w-full rounded-lg p-4 lg:p-8 dark:bg-blue-900">
        <div class="mb-8 text-center">
          <h3 class="text-xl font-medium leading-6 text-gray-900 dark:text-white mb-2">
            Información de Contacto
          </h3>
          <p class="text-md text-muted">No dudes en comunicarte por cualquiera de estos medios</p>
        </div>
        <div class="space-y-6">
          <div class="flex items-center">
            <div class="flex h-10 w-10 items-center justify-center rounded bg-blue-900 text-gray-50 dark:bg-blue-900">
              <Icon name="tabler:mail" class="h-5 w-5" />
            </div>
            <div class="ml-4 md:ml-6">
              <h4 class="font-medium text-gray-900 dark:text-white">Email</h4>
              <p class="text-muted text-sm sm:text-base">juancarlos@elitekode.com</p>
            </div>
          </div>
          <div class="flex items-center">
            <div class="flex h-10 w-10 items-center justify-center rounded bg-blue-900 text-gray-50 dark:bg-blue-900">
              <Icon name="tabler:map-pin" class="h-5 w-5" />
            </div>
            <div class="ml-4 md:ml-6">
              <h4 class="font-medium text-gray-900 dark:text-white">Ubicación</h4>
              <p class="text-muted text-sm sm:text-base">Barcelona, España</p>
            </div>
          </div>
          <div class="flex items-center">
            <div class="flex h-10 w-10 items-center justify-center rounded bg-blue-900 text-gray-50 dark:bg-blue-900">
              <Icon name="tabler:clock" class="h-5 w-5" />
            </div>
            <div class="ml-4 md:ml-6">
              <h4 class="font-medium text-gray-900 dark:text-white">Horario de Trabajo</h4>
              <p class="text-muted text-sm sm:text-base">Lunes - Viernes: 9:00 - 18:00</p>
            </div>
          </div>
        </div>
        <div class="mt-8 flex justify-center space-x-4">
          <a href="https://www.linkedin.com/in/juancarlossalgadoascencio/" target="_blank" class="hover:text-primary">
            <Icon name="tabler:brand-linkedin" class="h-8 w-8" />
          </a>
          <a href="https://github.com/jios325" target="_blank" class="hover:text-primary">
            <Icon name="tabler:brand-github" class="h-8 w-8" />
          </a>
          <a href="https://www.instagram.com/juancarlossalgado__" target="_blank" class="hover:text-primary">
            <Icon name="tabler:brand-instagram" class="h-8 w-8" />
          </a>
          <a href="https://linktr.ee/juancarlossalgado" target="_blank" class="hover:text-primary">
            <Icon name="tabler:tree" class="h-8 w-8" />
          </a>
        </div>
      </div>
    </div>
  </div>
</WidgetWrapper>
