---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Grid from '~/components/ui/Grid.astro';
import Card from '~/components/ui/Card.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';

const metadata = {
  title: 'Portfolio | J. Carlos Salgado - Web para Hotelería',
  description: 'Casos de éxito de proyectos web para hoteles, con resultados medibles en aumento de reservas directas, mejora de conversión y reducción de dependencia de OTAs.',
};

const projects = [
  {
    title: 'Hotel Vista Mar',
    description: 'Rediseño completo del sitio web y optimización del motor de reservas que resultó en un aumento del 42% en reservas directas y una reducción del 25% en la dependencia de OTAs.',
    image: '~/assets/images/portfolio-1.jpg',
    url: '/portfolio/hotel-vista-mar',
    tags: ['Diseño Web', 'CRO', 'SEO'],
  },
  {
    title: 'Cadena Hoteles Norte',
    description: 'Estrategia SEO especializada para 5 hoteles, logrando posiciones Top 3 para términos clave relacionados con sus destinos y un aumento del 68% en tráfico orgánico.',
    image: '~/assets/images/portfolio-2.jpg',
    url: '/portfolio/cadena-hoteles-norte',
    tags: ['SEO', 'Contenidos', 'Local SEO'],
  },
  {
    title: 'Hotel Boutique Plaza',
    description: 'Optimización del proceso de reserva que mejoró la tasa de conversión de 1.8% a 4.5%, duplicando efectivamente los ingresos por reservas directas.',
    image: '~/assets/images/portfolio-3.jpg',
    url: '/portfolio/hotel-boutique-plaza',
    tags: ['CRO', 'UX/UI', 'Analítica'],
  },
  {
    title: 'Resort Costa Azul',
    description: 'Implementación de un nuevo sitio web con motor de reservas integrado y estrategia de contenidos que aumentó las reservas directas en un 38% en el primer trimestre.',
    image: '~/assets/images/portfolio-4.jpg',
    url: '/portfolio/resort-costa-azul',
    tags: ['Diseño Web', 'Integraciones', 'Content'],
  },
  {
    title: 'Grupo Hotelero Montaña',
    description: 'Gestión de proyecto para la implementación de un nuevo PMS y su integración con el motor de reservas, finalizando a tiempo y dentro del presupuesto.',
    image: '~/assets/images/portfolio-5.jpg',
    url: '/portfolio/grupo-hotelero-montana',
    tags: ['Project Management', 'Integración', 'PMS'],
  },
  {
    title: 'Hotel Céntrico',
    description: 'Estrategia SEO local que posicionó al hotel en el Top 3 de Google Maps para búsquedas relacionadas con su ubicación, aumentando visibilidad y tráfico cualificado.',
    image: '~/assets/images/portfolio-6.jpg',
    url: '/portfolio/hotel-centrico',
    tags: ['SEO Local', 'Google Maps', 'GMB'],
  },
];
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    title="Portfolio"
    subtitle="Proyectos exitosos de transformación digital para la industria hotelera, con resultados medibles y estrategias replicables."
  />

  <!-- Projects Grid ******************* -->

  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
    <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
      {
        projects.map((project) => (
          <Card class="mb-6 transition">
            <Image
              src={project.image}
              class="w-full h-64 md:h-48 lg:h-64 object-cover rounded-md"
              alt={project.title}
              aspectRatio="16:9"
              loading="lazy"
              decoding="async"
            />
            <div class="py-4">
              <div class="flex gap-2 mb-2">
                {project.tags.map((tag) => (
                  <span class="inline-block bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs px-2 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
              <h3 class="text-xl font-bold leading-tight sm:text-2xl mb-2">
                <a href={project.url} class="hover:text-primary transition ease-in duration-200">
                  {project.title}
                </a>
              </h3>
              <p class="text-muted">{project.description}</p>
              <div class="mt-4">
                <a href={project.url} class="text-primary hover:underline inline-flex items-center">
                  Ver caso de estudio
                  <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- Testimonials Section ************ -->
  
  <section class="relative">
    <div class="absolute inset-0 bg-blue-50 dark:bg-slate-800/40"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16 lg:py-20 text-center">
      <blockquote class="text-xl md:text-2xl italic text-gray-700 dark:text-gray-300 font-medium max-w-4xl mx-auto">
        "El trabajo de J. Carlos ha sido transformador para nuestro hotel. No solo entregó un sitio web excepcional, sino que realmente entendió nuestras necesidades como negocio hotelero y tradujo eso en una solución que ha superado todas nuestras expectativas en términos de resultados."
      </blockquote>
      <div class="mt-4 md:mt-6">
        <span class="font-bold">María López</span>
        <span class="text-gray-500 dark:text-gray-400"> • Directora de Hotel Boutique Alameda</span>
      </div>
    </div>
  </section>

  <!-- Metrics Section ************ -->
  
  <section class="relative max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16 lg:py-20">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold mb-4">Resultados que hablan por sí solos</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400">Datos promedio conseguidos en los proyectos para clientes hoteleros</p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-primary mb-2">+42%</div>
        <div class="text-gray-600 dark:text-gray-400">Aumento en reservas directas</div>
      </div>
      <div class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-primary mb-2">-28%</div>
        <div class="text-gray-600 dark:text-gray-400">Reducción dependencia OTAs</div>
      </div>
      <div class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-primary mb-2">+65%</div>
        <div class="text-gray-600 dark:text-gray-400">Mejora en tráfico orgánico</div>
      </div>
      <div class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-primary mb-2">540%</div>
        <div class="text-gray-600 dark:text-gray-400">ROI promedio</div>
      </div>
    </div>
  </section>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Consulta gratuita',
        href: '/contacto',
        icon: 'tabler:message',
      },
      {
        text: 'Ver servicios',
        href: '/servicios',
      },
    ]}
  >
    <Fragment slot="title">
      ¿Listo para transformar la presencia digital de tu hotel?
    </Fragment>

    <Fragment slot="subtitle">
      Agenda una consulta gratuita para analizar tu situación actual y descubrir cómo puedo ayudarte a conseguir resultados similares.
    </Fragment>
  </CallToAction>
</Layout>
