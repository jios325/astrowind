---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'J. Carlos Salgado | Project Manager Especializado en Web para Hotelería',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Solicitar consulta',
        href: '/contacto',
        icon: 'tabler:calendar',
      },
      { text: 'Ver portfolio', href: '/portfolio' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Project Manager web para hoteles' }}
  >
    <Fragment slot="title">
      Project Manager especializado en <span class="text-accent dark:text-white highlight">soluciones web</span> para la industria hotelera
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Transformo la presencia digital</span> de hoteles con soluciones web que maximizan reservas y experiencia de usuario.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Soluciones web para hoteles.</span>
      Combino gestión efectiva de proyectos con conocimiento técnico avanzado para crear sitios web hoteleros que generan resultados.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note>
    <Fragment slot="content">
      <span class="font-bold">35% más de reservas directas</span> es el promedio que consiguen mis clientes tras implementar mis soluciones web. <a href="/portfolio" class="text-blue-600 hover:underline">Ver casos de éxito &rarr;</a>
    </Fragment>
  </Note>

  <!-- Features Widget *************** -->

  <Features
    id="servicios"
    tagline="Servicios"
    title="Soluciones web especializadas para hotelería"
    subtitle="Cada servicio está diseñado para atender las necesidades específicas de la industria hotelera, maximizando resultados y ROI."
    items={[
      {
        title: 'Diseño Web para Hoteles',
        description:
          'Sitios web atractivos y funcionales optimizados para reservas directas, con experiencia de usuario intuitiva y diseño responsivo.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'SEO para Hoteles',
        description:
          'Estrategias de posicionamiento específicas para el sector hotelero, con enfoque local y optimización para búsquedas relevantes.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Optimización de Conversión',
        description:
          'Mejora del rendimiento del motor de reservas y aumento de la tasa de conversión para maximizar las reservas directas.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Project Management',
        description:
          'Gestión integral de proyectos digitales para el sector hotelero, asegurando la entrega puntual y dentro del presupuesto.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Integración de Sistemas',
        description:
          'Implementación y configuración de PMS, Channel Manager y otras herramientas tecnológicas para la gestión hotelera.',
        icon: 'tabler:plug',
      },
      {
        title: 'Mantenimiento y Soporte',
        description:
          'Servicio continuo para garantizar que tu presencia digital se mantenga actualizada, segura y con óptimo rendimiento.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Enfoque"
    title="Metodología orientada a resultados"
    items={[
      {
        title: 'Análisis detallado',
        description:
          'Estudio completo de necesidades, competencia y oportunidades específicas de tu hotel.',
      },
      {
        title: 'Estrategia personalizada',
        description:
          'Desarrollo de un plan de acción adaptado a los objetivos concretos de tu establecimiento.',
      },
      {
        title: 'Implementación experta',
        description:
          'Ejecución profesional con atención al detalle y enfoque en la experiencia del usuario.',
      },
    ]}
    image={{
      src: '~/assets/images/methodology.jpg',
      alt: 'Metodología de trabajo para proyectos web hoteleros',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Mi enfoque diferencial</h3>
      Maximizo tus resultados combinando conocimiento técnico y comprensión profunda del sector hotelero
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Proceso de trabajo estructurado y eficiente"
    items={[
      {
        title: 'Consulta y diagnóstico',
        description:
          'Analizamos en profundidad tu situación actual, objetivos y necesidades específicas para establecer una estrategia clara.',
        icon: 'tabler:search',
      },
      {
        title: 'Planificación detallada',
        description:
          'Desarrollamos un plan de proyecto completo con cronograma, recursos necesarios y métricas de éxito claramente definidas.',
        icon: 'tabler:map',
      },
      {
        title: 'Diseño y desarrollo',
        description:
          'Creamos soluciones web optimizadas para el sector hotelero, con enfoque en usabilidad, conversión y experiencia de usuario.',
        icon: 'tabler:paint',
      },
      {
        title: 'Pruebas y lanzamiento',
        description:
          'Implementamos exhaustivas pruebas de calidad antes del lanzamiento para garantizar un funcionamiento perfecto.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Medición y optimización',
        description:
          'Analizamos constantemente el rendimiento y realizamos mejoras continuas para maximizar los resultados.',
        icon: 'tabler:chart-bar',
      }
    ]}
    image={{
      src: '~/assets/images/process.jpg',
      alt: 'Proceso de trabajo para proyectos web hoteleros',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Especialización en el sector hotelero"
    subtitle="Soluciones específicas para los desafíos digitales de la industria hotelera"
    tagline="Expertise"
    items={[
      {
        title: 'Motores de reserva optimizados',
        description: 'Implementación y optimización para maximizar conversiones y minimizar abandonos.',
        icon: 'tabler:calendar',
      },
      {
        title: 'SEO Local y de destino',
        description: 'Estrategias específicas para posicionar tu hotel en búsquedas geográficas relevantes.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Experiencia móvil perfecta',
        description: 'Diseño responsive optimizado para reservas desde cualquier dispositivo.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Integración con PMS',
        description: 'Conexión perfecta con tu sistema de gestión hotelera para administración centralizada.',
        icon: 'tabler:database',
      },
      {
        title: 'Estrategia de contenido',
        description: 'Desarrollo de contenido atractivo sobre destinos, experiencias y servicios hoteleros.',
        icon: 'tabler:article',
      },
      {
        title: 'Reportes y analytics',
        description: 'Informes detallados sobre rendimiento y conversiones para toma de decisiones informadas.',
        icon: 'tabler:report-analytics',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Últimos artículos del blog"
    information="Recursos, guías y estrategias para mejorar la presencia digital de tu hotel."
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas frecuentes"
    subtitle="Resuelve tus dudas sobre cómo puedo ayudarte a mejorar la presencia digital de tu hotel."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Cuánto tiempo toma desarrollar un sitio web para un hotel?',
        description:
          'El tiempo varía según la complejidad, pero generalmente un sitio web hotelero completo toma entre 8 y 12 semanas desde la planificación hasta el lanzamiento. Proyectos más complejos con integraciones personalizadas pueden requerir más tiempo.',
      },
      {
        title: '¿Qué resultados puedo esperar tras el rediseño de mi web hotelera?',
        description:
          'Los clientes típicamente experimentan un aumento del 20-40% en reservas directas, mejora en la tasa de conversión, reducción de la dependencia de OTAs, y mejor posicionamiento en buscadores para términos relevantes de su ubicación y servicios.',
      },
      {
        title: '¿Trabajas con hoteles de todos los tamaños?',
        description:
          'Sí, he trabajado con hoteles independientes, pequeñas cadenas y grandes resorts. Mi enfoque se adapta al tamaño y necesidades específicas de cada establecimiento, ofreciendo soluciones escalables y personalizadas.',
      },
      {
        title: '¿Qué diferencia a un sitio web hotelero efectivo?',
        description:
          'Un sitio web hotelero efectivo combina diseño atractivo, usabilidad intuitiva, velocidad de carga optimizada, motor de reservas eficiente, contenido persuasivo, y estrategia SEO especializada para el sector. El enfoque debe estar en convertir visitantes en huéspedes directos.',
      },
      {
        title: '¿Ofreces servicios de mantenimiento continuo?',
        description:
          'Sí, ofrezco planes de mantenimiento y optimización continua que incluyen actualizaciones técnicas, mejoras de rendimiento, análisis de conversión y ajustes de estrategia SEO para mantener y mejorar los resultados a largo plazo.',
      },
      {
        title: '¿Cómo iniciamos un proyecto juntos?',
        description:
          'El proceso comienza con una consulta inicial gratuita donde analizamos tu situación actual, objetivos y necesidades. Tras esta conversación, preparo una propuesta detallada con alcance, presupuesto y cronograma para tu consideración.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Proyectos Completados', amount: '85+' },
      { title: 'Aumento Promedio en Reservas', amount: '35%' },
      { title: 'Años de Experiencia', amount: '12' },
      { title: 'Clientes Satisfechos', amount: '70+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Solicitar consulta gratuita',
        href: '/contacto',
        icon: 'tabler:calendar',
      },
    ]}
  >
    <Fragment slot="title">
      Transforma la presencia digital de tu hotel
    </Fragment>

    <Fragment slot="subtitle">
      Agenda una consultoría gratuita para analizar tu situación actual y descubrir oportunidades de mejora para tu hotel.
    </Fragment>
  </CallToAction>
</Layout>
