---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'J. Carlos Salgado — Project Manager Especializado en Soluciones Web para la Industria Hotelera',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Contacto',
        href: '/contacto',
        icon: 'tabler:mail',
      },
      { text: 'Ver Portafolio', href: '/portfolio' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'J. Carlos Salgado - Project Manager' }}
  >
    <Fragment slot="title">
      Project Manager Especializado en <span class="text-accent dark:text-white highlight">Soluciones Web</span> para la Industria Hotelera
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Con 12 años de experiencia</span>, lidero proyectos web que elevan la industria hotelera, integrando SEO y CRO con innovación tecnológica.</span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">12 años de experiencia en transformación digital hotelera.</span>
      Explora mi portafolio y descubre cómo he transformado la presencia online y operaciones de hoteles líderes.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Aumento en Reservas Directas', amount: '+35%' },
      { title: 'Proyectos Completados', amount: '120+' },
      { title: 'Hoteles Satisfechos', amount: '50+' },
      { title: 'Ahorro en Comisiones OTAs', amount: '28%' },
    ]}
  />

  <!-- Features Widget *************** -->

  <Features
    id="servicios"
    tagline="Servicios"
    title="Soluciones Especializadas para el Sector Hotelero"
    subtitle="Ofrezco servicios integrales diseñados específicamente para potenciar la presencia digital de hoteles y maximizar su rentabilidad a través de canales directos."
    items={[
      {
        title: 'Diseño Web Hotelero',
        description:
          'Sitios web a medida optimizados para convertir visitas en reservas directas, con énfasis en experiencia de usuario y velocidad de carga.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'SEO para Hoteles',
        description:
          'Estrategias de posicionamiento específicas para el sector hotelero, enfocadas en captar búsquedas de alta intención de reserva.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Optimización de Conversión (CRO)',
        description:
          'Mejora de ratios de conversión en motores de reserva mediante análisis de datos, pruebas A/B y optimización continua.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Gestión Técnica de Proyectos',
        description:
          'Coordinación integral de equipos multidisciplinarios para entregar proyectos web hoteleros en tiempo y presupuesto.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Infraestructura Tecnológica',
        description:
          'Configuración de servidores, integraciones API y arquitectura técnica optimizada para el rendimiento y la seguridad.',
        icon: 'tabler:server',
      },
      {
        title: 'Formación y Consultoría',
        description:
          'Capacitación a equipos hoteleros sobre tecnologías web, estrategias digitales y mejores prácticas en transformación digital.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Mi Enfoque"
    title="Metodología de Gestión de Proyectos Web para Hoteles"
    items={[
      {
        title: 'Análisis de Necesidades Específicas',
        description:
          'Comprensión profunda del hotel, su público objetivo y desafíos particulares para crear soluciones verdaderamente personalizadas.',
      },
      {
        title: 'Balanceando Tecnología y Experiencia',
        description:
          'Combinación de innovación tecnológica con experiencia de usuario intuitiva, adaptada al comportamiento del viajero digital.',
      },
      {
        title: 'Optimización de Canales Directos',
        description:
          'Enfoque estratégico en maximizar las reservas directas, reduciendo dependencia de OTAs y mejorando márgenes.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Metodología de Gestión de Proyectos',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Desarrollo estratégico con visión de resultados</h3>
      Mi enfoque combina gestión de proyectos sólida con conocimiento técnico avanzado, permitiéndome comunicarme eficazmente con todos los stakeholders y lograr resultados medibles para tu hotel.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Mi proceso de trabajo para transformar tu presencia web hotelera"
    items={[
      {
        title: 'Fase 1: <span class="font-medium">Diagnóstico y Estrategia</span>',
        description:
          'Análisis exhaustivo de tu situación actual, competencia y oportunidades. Definición de objetivos claros y medibles, identificación de KPIs y creación de un roadmap personalizado.',
        icon: 'tabler:search',
      },
      {
        title: 'Fase 2: <span class="font-medium">Planificación y Diseño</span>',
        description:
          'Desarrollo de arquitectura web, wireframes y diseños centrados en conversión. Planificación detallada de recursos, cronograma y entregables con puntos de control definidos.',
        icon: 'tabler:template',
      },
      {
        title: 'Fase 3: <span class="font-medium">Implementación y Desarrollo</span>',
        description:
          'Coordinación de equipos técnicos y creativos, desarrollo frontend y backend, integraciones con sistemas hoteleros (PMS, Channel Manager) y configuración de herramientas de analítica.',
        icon: 'tabler:code',
      },
      {
        title: 'Fase 4: <span class="font-medium">Optimización Continua</span>',
        description:
          'Análisis de datos, pruebas A/B, ajustes basados en comportamiento de usuarios, actualización constante de contenidos y refinamiento técnico para mejorar de manera consistente los resultados.',
        icon: 'tabler:refresh',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Proceso de trabajo',
    }}
  />

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Recursos y Artículos Sobre Tecnología Hotelera"
    information={`Explora mis últimos artículos sobre tendencias, estrategias y consejos prácticos para optimizar la presencia digital de tu hotel y maximizar las reservas directas.`}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas Frecuentes"
    subtitle="Resuelve tus dudas sobre proyectos web para hoteles y cómo puedo ayudarte a mejorar tu presencia digital y aumentar tus reservas directas."
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Cuánto tiempo toma desarrollar un sitio web para un hotel?',
        description:
          'El tiempo de desarrollo varía según la complejidad, pero generalmente un sitio web hotelero completo toma entre 8 y 12 semanas desde la planificación hasta el lanzamiento. Proyectos más complejos con integraciones de motor de reservas personalizados pueden requerir más tiempo.',
      },
      {
        title: '¿Qué diferencia a un sitio web hotelero efectivo?',
        description:
          'Un sitio web hotelero efectivo combina diseño atractivo, usabilidad intuitiva, velocidad de carga optimizada, motor de reservas eficiente, contenido persuasivo, y estrategia SEO especializada para el sector. El enfoque debe estar en convertir visitantes en huéspedes directos.',
      },
      {
        title: '¿Cómo puedo reducir mi dependencia de las OTAs?',
        description:
          'La estrategia incluye desarrollar un sitio web optimizado para conversión, implementar una estrategia SEO específica para hotelería, crear un programa de fidelización atractivo, utilizar email marketing efectivo, y optimizar continuamente la experiencia de reserva directa. Todo esto acompañado de una estrategia de precios coherente.',
      },
      {
        title: '¿Qué retorno de inversión puedo esperar de un proyecto de transformación digital?',
        description:
          'Los hoteles con los que he trabajado han experimentado aumentos de entre 25% y 40% en reservas directas en los primeros 6 meses tras la implementación. Esto se traduce en un ROI promedio de 300% en el primer año considerando el ahorro en comisiones a OTAs.',
      },
      {
        title: '¿Trabajas con hoteles de todos los tamaños?',
        description:
          'Sí, he trabajado con propiedades que van desde pequeños hoteles boutique de 15 habitaciones hasta cadenas con múltiples propiedades. La estrategia se adapta a las necesidades y recursos específicos de cada hotel, siempre con el objetivo de maximizar resultados.',
      },
      {
        title: '¿Ofrececes mantenimiento y soporte continuo tras el lanzamiento?',
        description:
          'Absolutamente. Ofrezco diferentes planes de mantenimiento y optimización continua que incluyen actualizaciones técnicas, análisis de rendimiento, ajustes basados en datos y soporte para problemas. El éxito digital es un proceso continuo, no un evento puntual.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Contactar Ahora',
        href: '/contacto',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Transforma la presencia digital de tu hotel
    </Fragment>

    <Fragment slot="subtitle">
      Agenda una consulta gratuita para analizar tu situación actual y descubrir cómo puedo ayudarte a aumentar tus reservas directas.
    </Fragment>
  </CallToAction>
</Layout>
