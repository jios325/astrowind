---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';
// Temporalmente quitamos el import de ContactForm
// import ContactForm from '~/components/widgets/ContactForm.astro';

const metadata = {
  title: 'Contacto - J. Carlos Salgado | Project Manager para Hoteles',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero>
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">Contáctame</span>
    </Fragment>

    <Fragment slot="subtitle">
      Estoy aquí para responder tus preguntas y discutir cómo podemos llevar tus proyectos de hotelería digital al siguiente nivel. Ya sea que estés buscando asesoramiento experto en gestión de proyectos web, una consulta sobre SEO y CRO, o simplemente quieras explorar posibles colaboraciones, no dudes en ponerte en contacto.
    </Fragment>
  </Hero>

  <!-- Formulario de contacto temporal -->
  <div class="max-w-5xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Envíame un Mensaje
      </h2>
      <p class="text-xl text-gray-600 dark:text-slate-400">
        Completa el formulario a continuación y me pondré en contacto contigo en un plazo máximo de 24 horas laborables.
      </p>
    </div>
    
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <form class="space-y-6" action="#" method="POST">
          <div>
            <label for="nombre" class="block text-sm font-medium">Nombre <span class="text-red-600">*</span></label>
            <input type="text" id="nombre" name="nombre" required 
                  class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-slate-900">
          </div>
          
          <div>
            <label for="email" class="block text-sm font-medium">Email <span class="text-red-600">*</span></label>
            <input type="email" id="email" name="email" required 
                  class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-slate-900">
          </div>
          
          <div>
            <label for="asunto" class="block text-sm font-medium">Asunto <span class="text-red-600">*</span></label>
            <select id="asunto" name="asunto" required
                  class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-slate-900">
              <option value="diseno-web">Diseño Web Hotelero</option>
              <option value="seo">SEO para Hoteles</option>
              <option value="cro">Optimización de Conversión</option>
              <option value="gestion-proyectos">Gestión de Proyectos</option>
              <option value="otro">Otro Asunto</option>
            </select>
          </div>
          
          <div>
            <label for="mensaje" class="block text-sm font-medium">Mensaje <span class="text-red-600">*</span></label>
            <textarea id="mensaje" name="mensaje" rows="5" required
                    class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-slate-900"
                    placeholder="Tu mensaje aquí..."></textarea>
          </div>
          
          <div class="text-sm text-gray-600 dark:text-slate-400">
            Al enviar este formulario, aceptas nuestra <a href="/privacidad" class="text-primary hover:underline">política de privacidad</a>.
          </div>
          
          <div>
            <button type="submit" 
                  class="inline-flex items-center justify-center rounded-md border-primary-600 bg-primary-600 px-6 py-3 text-center text-base font-medium text-white shadow-md transition duration-150 ease-in-out hover:bg-primary-800 hover:border-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:bg-primary-700 dark:border-primary-700 dark:hover:bg-primary-900 dark:hover:border-primary-900 dark:focus:ring-primary-900 dark:focus:ring-offset-gray-800">
              Enviar Mensaje
            </button>
          </div>
        </form>
      </div>
      
      <div>
        <div class="bg-primary-100 relative h-full max-w-full rounded-lg p-4 lg:p-8 dark:bg-blue-900">
          <div class="mb-8 text-center">
            <h3 class="text-xl font-medium leading-6 text-gray-900 dark:text-white mb-2">
              Información de Contacto
            </h3>
            <p class="text-md text-muted dark:text-slate-300">No dudes en comunicarte por cualquiera de estos medios</p>
          </div>
          <div class="space-y-6">
            <div class="flex items-center">
              <div class="flex h-10 w-10 items-center justify-center rounded bg-blue-900 text-gray-50 dark:bg-blue-900">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div class="ml-4 md:ml-6">
                <h4 class="font-medium text-gray-900 dark:text-white">Email</h4>
                <p class="text-muted text-sm sm:text-base dark:text-slate-300">juancarlos@elitekode.com</p>
              </div>
            </div>
            <div class="flex items-center">
              <div class="flex h-10 w-10 items-center justify-center rounded bg-blue-900 text-gray-50 dark:bg-blue-900">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="ml-4 md:ml-6">
                <h4 class="font-medium text-gray-900 dark:text-white">Ubicación</h4>
                <p class="text-muted text-sm sm:text-base dark:text-slate-300">Barcelona, España</p>
              </div>
            </div>
            <div class="flex items-center">
              <div class="flex h-10 w-10 items-center justify-center rounded bg-blue-900 text-gray-50 dark:bg-blue-900">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <div class="ml-4 md:ml-6">
                <h4 class="font-medium text-gray-900 dark:text-white">Horario de Trabajo</h4>
                <p class="text-muted text-sm sm:text-base dark:text-slate-300">Lunes - Viernes: 9:00 - 18:00</p>
              </div>
            </div>
          </div>
          <div class="mt-8 flex justify-center space-x-4">
            <a href="https://linkedin.com/in/jcarlossalgado" target="_blank" class="text-gray-900 hover:text-primary-600 dark:text-white dark:hover:text-primary-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
            <a href="https://github.com/jios325" target="_blank" class="text-gray-900 hover:text-primary-600 dark:text-white dark:hover:text-primary-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            </a>
            <a href="https://twitter.com/jcarlossalgado" target="_blank" class="text-gray-900 hover:text-primary-600 dark:text-white dark:hover:text-primary-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Features2 Widget ************** -->
  <Features2
    title="Otras Formas de Contacto"
    subtitle="Si prefieres comunicarte por otros medios, tienes varias opciones para contactarme."
    items={[
      {
        title: 'Email',
        description: 'juancarlos@elitekode.com',
        icon: 'tabler:mail',
      },
      {
        title: 'LinkedIn',
        description: 'Conéctate conmigo en LinkedIn',
        icon: 'tabler:brand-linkedin',
        callToAction: {
          text: 'Visitar Perfil',
          href: 'https://linkedin.com/in/jcarlossalgado',
          target: '_blank',
        },
      },
      {
        title: 'Agendar una Llamada',
        description: 'Reserva una consulta gratuita de 30 minutos',
        icon: 'tabler:calendar',
        callToAction: {
          text: 'Agendar Ahora',
          href: '/consulta',
        },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Content Widget **************** -->
  <Content
    isReversed
    title="¿Qué sucede después de contactarme?"
    items={[
      {
        title: '1. Respuesta Inicial',
        description:
          'Recibirás una confirmación inmediata y una respuesta personalizada dentro de las próximas 24 horas laborables.',
      },
      {
        title: '2. Consulta Inicial Gratuita',
        description:
          'Agendaremos una llamada de 30 minutos para discutir tu proyecto, necesidades y objetivos específicos.',
      },
      {
        title: '3. Propuesta Personalizada',
        description:
          'Basado en nuestra conversación, prepararé una propuesta detallada con soluciones adaptadas a tus necesidades.',
      },
      {
        title: '4. Inicio del Proyecto',
        description:
          'Una vez aprobada la propuesta, comenzaremos con una reunión de kickoff para definir el plan de acción y cronograma.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Proceso de trabajo',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Ver Portfolio',
        href: '/portfolio',
        icon: 'tabler:briefcase',
      },
      {
        text: 'Conocer Servicios',
        href: '/servicios',
      },
    ]}
  >
    <Fragment slot="title">
      ¿Prefieres ver mi trabajo antes de contactarme?
    </Fragment>

    <Fragment slot="subtitle">
      Explora mi portfolio para conocer casos de éxito reales y los resultados obtenidos con otros hoteles
    </Fragment>
  </CallToAction>
</Layout>
